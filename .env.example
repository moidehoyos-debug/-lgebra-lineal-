# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VECTORIA_ADMIN_PASSCODE: Optional initial admin passphrase (>= 8 chars) for Visual Builder.
# If omitted, administrators must supply the one-time server bootstrap token to initialize credentials.
VECTORIA_ADMIN_PASSCODE=""

# VECTORIA_EDITOR_PASSCODE: Optional initial editor passphrase (>= 8 chars) for Visual Builder.
VECTORIA_EDITOR_PASSCODE=""

# VECTORIA_VIEWER_PASSCODE: Optional initial read-only reviewer passphrase (>= 8 chars).
VECTORIA_VIEWER_PASSCODE=""

# VECTORIA_SETUP_TOKEN: Optional bootstrap token (>= 12 chars) required for /api/builder/auth/setup when VECTORIA_ADMIN_PASSCODE is unset.
VECTORIA_SETUP_TOKEN=""
